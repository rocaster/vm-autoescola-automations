{
  "name": "VM Autoescola - Congratulations on the driver license (CNH)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                0,
                1,
                2,
                4,
                3,
                6,
                5
              ],
              "triggerAtHour": 10
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        1024,
        1280
      ],
      "id": "ab7b8d14-7052-4809-9df4-085878c0044a",
      "name": "Concluído / CNH Emitida"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  l.name,\n  l.phone,\n  l.x_sexo\nFROM\n  crm_lead l\nLEFT JOIN crm_stage s ON l.stage_id = s.id\nWHERE\n  s.name::text LIKE '%Concluído / CNH Emitida%'\n  AND DATE(l.date_last_stage_update AT TIME ZONE 'UTC' AT TIME ZONE 'America/Fortaleza') = DATE(NOW() AT TIME ZONE 'America/Fortaleza' - INTERVAL '1 day');",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1216,
        1280
      ],
      "id": "b3e6e09d-0f6e-4473-b1b5-8fff0c42a411",
      "name": "Execute a SQL query8",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution-api:8080/message/sendText/vmautoescola",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_EVOLUTION_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.phone.replace(/\\\\D/g, '') }}\",\n  \"options\": {\n    \"delay\": 1500,\n    \"presence\": \"composing\"\n  },\n  \"textMessage\": {\n    \"text\": \"Olá, {{ $json.name.split(' ')[0] }}! 🎉 Passando aqui para te dar os parabéns pela emissão da sua CNH! A equipe da VM Autoescola fica muito feliz e orgulhosa de fazer parte dessa sua conquista. Desejamos muito sucesso e prudência no trânsito. Um grande abraço!\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1424,
        1280
      ],
      "id": "a80e9945-b93d-4dea-8490-4c167bdcbe7f",
      "name": "HTTP Request16"
    }
  ],
